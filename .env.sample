# --- FastMSR ---------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored — never commit secrets.

# Admin login (override the demo defaults in any real deployment!)
FASTMSR_ADMIN_EMAIL=admin@fastmsr.example
FASTMSR_ADMIN_PASSWORD=FastMSR2026$

# Long random hex; leave blank to auto-generate a per-boot secret (sessions
# reset on restart). Set a fixed value to keep users logged in across restarts.
FASTMSR_SECRET=

# HTTP port and the label shown in the top bar.
FASTMSR_PORT=5008
FASTMSR_ENV_LABEL=Demo · Synthetic

# Path to the SQLite database. Blank => ./fastmsr.sqlite next to the app.
# In Docker, mount a volume and point this at it, e.g. /data/fastmsr.sqlite
FASTMSR_DB=

# Set to 1 for auto-reload during development.
FASTMSR_RELOAD=0
